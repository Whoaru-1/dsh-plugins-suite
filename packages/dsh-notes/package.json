{
  "name": "dsh-notes",
  "version": "1.0.0",
  "private": true,
  "description": "A daily sticky-note wall in the DSH sidebar: jot a thought, keep it by the day, and find it again.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  }
}

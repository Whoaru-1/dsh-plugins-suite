{
  "name": "dsh-office-preview",
  "version": "1.0.0",
  "private": true,
  "description": "DSH sidebar document previews for the formats the official viewer cannot show: Word (.docx), Excel (.xlsx/.xls), PowerPoint (.pptx) and delimited tables (.csv/.tsv), plus a clear fallback for other binary files.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "docx-preview": "^0.4.0",
    "pptx-preview": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

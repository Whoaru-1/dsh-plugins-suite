{
  "name": "dsh-balance",
  "version": "1.0.0",
  "private": true,
  "description": "DSH API balance surface: a composer capsule and a settings section showing the DeepSeek account balance, read from the provider's balance endpoint through a key-holding host proxy.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-host.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  }
}

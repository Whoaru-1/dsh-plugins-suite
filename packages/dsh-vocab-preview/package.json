{
  "name": "dsh-vocab-preview",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-opens a 剧有词 (series-vocab) HTML learning page in the DSH right-side preview as soon as a turn produces one.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
